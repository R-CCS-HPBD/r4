{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "r4-aurora",
  "description": "R4 Platform design tokens — single source of truth for webview, TUI, web, CLI",
  "color": {
    "accent": {
      "primary": "#7C6CFF",
      "primaryHover": "#8F81FF",
      "secondary": "#2DD4EE",
      "tertiary": "#F472B6"
    },
    "semantic": {
      "success": "#34D399",
      "warning": "#FBBF24",
      "error": "#FB7185",
      "info": "#38BDF8"
    },
    "surface": {
      "base": "#111018",
      "raised": "#1A1826",
      "overlay": "#232138",
      "border": "#2E2B45"
    },
    "text": {
      "primary": "#EDEDF4",
      "secondary": "#A5A3C2",
      "muted": "#6B698C",
      "onAccent": "#FFFFFF"
    },
    "gradient": {
      "aurora": "linear-gradient(135deg, #7C6CFF 0%, #2DD4EE 100%)",
      "auroraSoft": "linear-gradient(135deg, rgba(124,108,255,0.16) 0%, rgba(45,212,238,0.16) 100%)",
      "verifying": "linear-gradient(90deg, #7C6CFF, #2DD4EE, #34D399, #7C6CFF)"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "120ms",
      "base": "240ms",
      "slow": "420ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.22, 1, 0.36, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "typography": {
    "family": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic UI', Meiryo, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "11px",
      "sm": "12px",
      "base": "13px",
      "lg": "15px",
      "xl": "18px",
      "display": "24px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.3)",
    "md": "0 4px 12px rgba(0,0,0,0.35)",
    "glow": "0 0 12px rgba(124,108,255,0.45)",
    "glowCyan": "0 0 12px rgba(45,212,238,0.4)"
  }
}
