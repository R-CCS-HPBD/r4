{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@r4/web",
  "version": "0.2.0-rc.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "R4 Research Operations Web Console — authenticated shell behind compose NGINX /app/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
