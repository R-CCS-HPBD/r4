{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@r4/tui-v3",
  "version": "0.2.0-rc.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "R4 Research Operations Console v3 — mascot, constellation viz, real backend adapters",
  "exports": {
    ".": "./src/index.tsx",
    "./app": "./src/app.tsx",
    "./stores": "./src/stores/index.ts",
    "./themes": "./src/themes/index.ts",
    "./adapters": "./src/adapters/index.ts"
  },
  "scripts": {
    "dev": "bun --preload @opentui/solid/preload src/index.tsx",
    "start": "bun --preload @opentui/solid/preload src/cli.tsx",
    "smoke": "bun --preload @opentui/solid/preload src/cli.tsx --smoke",
    "build:bin": "bun run typecheck && bun run scripts/build-bin.mjs",
    "test": "bun scripts/run-tests.ts",
    "test:pty": "R4_PTY_LIVE=1 bun test tests/pty-live/journeys.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run smoke"
  },
  "bin": {
    "r4-console-v3": "./src/cli.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.3.4",
    "@opentui/keymap": "0.3.4",
    "@opentui/solid": "0.3.4",
    "@xterm/headless": "^6.0.0",
    "asciichart": "1.5.25",
    "cli-spinners": "3.4.0",
    "drawille": "1.1.1",
    "figlet": "1.11.3",
    "fuzzysort": "3.1.0",
    "gradient-string": "3.0.0",
    "luxon": "3.6.1",
    "shiki": "^4.4.3",
    "solid-js": "1.9.16",
    "ulid": "3.0.1"
  },
  "devDependencies": {
    "@opentui/core-linux-arm64": "0.3.4",
    "@opentui/core-linux-arm64-musl": "0.3.4",
    "@opentui/core-linux-x64": "0.3.4",
    "@opentui/core-linux-x64-musl": "0.3.4",
    "@types/bun": "1.3.13",
    "@types/figlet": "1.7.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
