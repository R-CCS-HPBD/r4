# ADR-093 S8: the second stand-alone installation's overrides.
#
# s8_second_install.sh exports these before it calls deploy/standalone/
# standalone.sh. A set variable wins over deploy/standalone/env/*.env
# (ADR-008), so no file of the live stack is edited. No secrets here: the
# second installation reads the same env/.env.secrets as the first
# (standalone.sh reads it from a fixed path).

# The compose project: containers, networks and volumes are named by it.
# Never ai4s-standalone (the source stack); the script refuses that name.
COMPOSE_PROJECT_NAME=ai4s-s8

# The dev profile mounts the checkout's umrs/src and r4-contracts, so the
# second installation runs the same import and retrieval code as the source.
STANDALONE_PROFILE=dev

# core only: S8 retrieves and reads no verdict, so no models container (and
# no chat model to stage or register).
STANDALONE_PROFILES=core

# Host ports for the second installation. deploy/standalone/compose.yaml and
# compose.dev.yaml publish FIXED host ports today and read none of these;
# until they do, s8_second_install.sh runs in sequential mode (the source
# stack stopped). The compose change these names are for, one line per
# published port, is in benchmarks/retrieval/README.md (S8).
STANDALONE_GATEWAY_PORT=18080
STANDALONE_ZMQ_PORT=15555
STANDALONE_ZMQ_DATA_PORTS=15556-15563
STANDALONE_UMRS_HTTP_PORT=18082
STANDALONE_POSTGRES_PORT=15432
STANDALONE_S3_PORT=19000
STANDALONE_S3_IAM_PORT=18111
STANDALONE_SIDECAR_PORT=18081
