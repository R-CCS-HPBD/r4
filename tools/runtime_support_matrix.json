{
  "version": "2026-05-15",
  "blessed_envelopes": ["hpc", "k8s", "dev-server"],
  "slo_definitions": {
    "gateway_p99_latency_ms": {
      "description": "Gateway proxy overhead (excluding upstream) p99 latency",
      "target": 50,
      "unit": "ms",
      "measurement": "histogram gateway_request_duration_seconds, le=0.05"
    },
    "umrs_job_submit_p99_latency_ms": {
      "description": "Time from job submit API call to durable persistence",
      "target": 500,
      "unit": "ms",
      "measurement": "histogram umrs_job_submit_duration_seconds, le=0.5"
    },
    "endpoint_readiness_p95_sec": {
      "description": "Time from endpoint-up request to LiteLLM readiness",
      "target": 120,
      "unit": "seconds",
      "measurement": "histogram umrs_endpoint_readiness_seconds, le=120"
    },
    "reconciler_sweep_interval_sec": {
      "description": "Maximum interval between reconciler sweeps",
      "target": 30,
      "unit": "seconds",
      "measurement": "gauge umrs_reconciler_last_sweep_age_seconds"
    },
    "audit_write_success_rate": {
      "description": "Fraction of critical audit events durably written",
      "target": 0.999,
      "unit": "ratio",
      "measurement": "counter gateway_audit_write_total / gateway_audit_attempt_total"
    },
    "crash_recovery_data_loss_window_sec": {
      "description": "Maximum data loss window on UMRS crash (durable job tracking)",
      "target": 0,
      "unit": "seconds",
      "measurement": "design invariant: all job state is fsync'd before ACK"
    }
  },
  "entries": [
    {
      "id": "hpc-slurm-podman",
      "envelope": "hpc",
      "profile": "hpc-full",
      "gateway": "nginx-sidecar",
      "transport": "http+zmq-tunnel",
      "execution_authority": "slurm",
      "runtime_wrapper": "slurm-podman",
      "storage": "postgres+minio+shared-posix",
      "egress": "egressguard+site-firewall",
      "support_level": "supported",
      "validation": "RCCS",
      "smoke_command": "./tests/run_hpc_tests.sh --gateway-smoke && ./tests/run_hpc_tests.sh --podman-smoke",
      "rollback": "Restore the previous site.yaml and env file, then restart UMRS and Gateway.",
      "required_services": ["postgres", "minio", "slurm", "gateway", "umrs", "egressguard"],
      "auth_model": "jwt-gateway-sidecar",
      "ha": "none",
      "readiness_gate": "docs/PRODUCTION_READINESS_GATE.md#hpc-full"
    },
    {
      "id": "hpc-slurm-singularity",
      "envelope": "hpc",
      "profile": "hpc-full",
      "gateway": "nginx-sidecar",
      "transport": "http+zmq-tunnel",
      "execution_authority": "slurm",
      "runtime_wrapper": "singularity",
      "storage": "postgres+minio+shared-posix",
      "egress": "egressguard+site-firewall",
      "support_level": "site_dependent",
      "validation": "operator-required",
      "smoke_command": "RIVAULT_ORCHESTRATOR=slurm ./tests/run_hpc_tests.sh --dry-run",
      "rollback": "Switch RIVAULT_ORCHESTRATOR back to slurm-podman or the prior validated site profile.",
      "required_services": ["postgres", "minio", "slurm", "gateway", "umrs", "egressguard"],
      "auth_model": "jwt-gateway-sidecar",
      "ha": "none",
      "readiness_gate": "docs/PRODUCTION_READINESS_GATE.md#hpc-full"
    },
    {
      "id": "hpc-minimal-zmq",
      "envelope": "hpc",
      "profile": "hpc-minimal",
      "gateway": "none",
      "transport": "zmq-only",
      "execution_authority": "slurm",
      "runtime_wrapper": "singularity",
      "storage": "postgres+shared-posix",
      "egress": "offline",
      "support_level": "site_dependent",
      "validation": "operator-required",
      "smoke_command": "RIVAULT_ORCHESTRATOR=slurm ./tests/run_hpc_tests.sh --dry-run",
      "rollback": "Stop UMRS, restore the previous single-node site.yaml, and restart with the prior Slurm partition.",
      "required_services": ["postgres", "slurm", "umrs"],
      "auth_model": "admin-token-only",
      "ha": "none",
      "readiness_gate": "docs/PRODUCTION_READINESS_GATE.md#hpc-minimal"
    },
    {
      "id": "k8s-native",
      "envelope": "k8s",
      "profile": "k8s-cluster",
      "gateway": "nginx-sidecar",
      "transport": "http+zmq",
      "execution_authority": "k8s",
      "runtime_wrapper": "k8s-job",
      "storage": "postgres+minio+pvc",
      "egress": "egressguard-networkpolicy",
      "support_level": "supported",
      "validation": "Integration",
      "smoke_command": "./tests/run_k8s_tests.sh --test-only",
      "rollback": "kubectl rollout undo the changed manifests or reapply the previous kustomize bundle.",
      "required_services": ["postgres", "minio", "k8s", "gateway", "umrs", "egressguard"],
      "auth_model": "jwt-gateway-sidecar",
      "ha": "k8s-native",
      "readiness_gate": "docs/PRODUCTION_READINESS_GATE.md#kubernetes"
    },
    {
      "id": "dev-server-compose",
      "envelope": "dev-server",
      "profile": "server",
      "gateway": "nginx-sidecar",
      "transport": "http+zmq",
      "execution_authority": "compose",
      "runtime_wrapper": "podman-compose",
      "storage": "postgres+minio-local",
      "egress": "egressguard",
      "support_level": "supported",
      "validation": "Integration",
      "smoke_command": "python tests/run_e2e_tests.py",
      "rollback": "Stop the compose/podman services and restore the previous env file and profile selection.",
      "required_services": ["postgres", "minio", "gateway", "umrs", "egressguard"],
      "auth_model": "jwt-gateway-sidecar",
      "ha": "none",
      "readiness_gate": "docs/PRODUCTION_READINESS_GATE.md#dev-server"
    },
    {
      "id": "local-dev-compose",
      "envelope": "dev-server",
      "profile": "development",
      "gateway": "included",
      "transport": "http+zmq",
      "execution_authority": "compose",
      "runtime_wrapper": "docker-compose",
      "storage": "ephemeral-compose",
      "egress": "dev-only",
      "support_level": "development",
      "validation": "Integration",
      "smoke_command": "python tests/run_e2e_tests.py",
      "rollback": "docker compose -f docker-compose.e2e.yaml down -v",
      "required_services": ["postgres", "minio", "umrs"],
      "auth_model": "dev-auth",
      "ha": "none",
      "readiness_gate": ""
    },
    {
      "id": "ci-compose",
      "envelope": "dev-server",
      "profile": "ci-testing",
      "gateway": "included",
      "transport": "http+zmq",
      "execution_authority": "compose",
      "runtime_wrapper": "docker-compose",
      "storage": "ephemeral-compose",
      "egress": "ci-only",
      "support_level": "ci",
      "validation": "CI",
      "smoke_command": "python tests/run_e2e_tests.py",
      "rollback": "docker compose -f docker-compose.e2e.yaml down -v",
      "required_services": ["postgres", "minio", "umrs"],
      "auth_model": "dev-auth",
      "ha": "none",
      "readiness_gate": ""
    },
    {
      "id": "hybrid-slurm-wrapper",
      "envelope": "hpc",
      "profile": "hpc-full",
      "gateway": "nginx-sidecar",
      "transport": "http+zmq-tunnel",
      "execution_authority": "slurm",
      "runtime_wrapper": "hybrid-wrapper",
      "storage": "postgres+minio+shared-posix",
      "egress": "egressguard+site-firewall",
      "support_level": "experimental",
      "validation": "RCCS smoke only",
      "smoke_command": "./tests/run_hpc_tests.sh --hybrid-slurm-smoke",
      "rollback": "Disable the hybrid wrapper flag and return to the slurm-podman profile.",
      "required_services": ["postgres", "minio", "slurm", "gateway", "umrs", "egressguard"],
      "auth_model": "jwt-gateway-sidecar",
      "ha": "none",
      "readiness_gate": ""
    },
    {
      "id": "python-gateway-dev",
      "envelope": "dev-server",
      "profile": "development",
      "gateway": "python-gateway",
      "transport": "http+zmq",
      "execution_authority": "compose",
      "runtime_wrapper": "docker-compose",
      "storage": "ephemeral-compose",
      "egress": "dev-only",
      "support_level": "compatibility",
      "validation": "Unit",
      "smoke_command": "python tests/run_e2e_tests.py",
      "rollback": "Switch back to the NGINX plus sidecar Gateway path.",
      "required_services": ["postgres", "minio", "umrs"],
      "auth_model": "dev-auth",
      "ha": "none",
      "readiness_gate": ""
    }
  ]
}