  {
   "id": 6,
   "type": "timeseries",
   "title": "LLM TTFT + TTFC (P11 SLO 30s) \u2014 p50/p95 by model",
   "description": "Time-to-first-streamed-chunk measured at the UMRS LLM route (rivault_llm_first_token_seconds, chunk anchor, source labels umrs). Ratified P11 headline SLO: p95 \u2264 30s over 10m. Panels map to the LLMFirstTokenSlow alert in observability/prometheus/alerts.yaml (same window + quantile). (C: rivault_llm_first_content_seconds \u2014 P11 decode leg, first non-empty content delta.)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "calcs": [],
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "timezone": [],
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(rivault_llm_first_token_seconds_bucket[10m])) by (le, model))",
     "legendFormat": "p95 {{model}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum(rate(rivault_llm_first_token_seconds_bucket[10m])) by (le, model))",
     "legendFormat": "p50 {{model}}"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(rivault_llm_first_content_seconds_bucket[10m])) by (le, model))",
     "legendFormat": "p95 content {{model}}"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(rivault_llm_decode_content_rate_deltas_per_second_bucket[10m])) by (le, model))",
     "legendFormat": "p95 decode-rate {{model}} (deltas/s)"
    }
   ]
  },
