{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/control/v1/thinking_done.schema.json",
  "title": "thinking_done",
  "description": "Terminal marker for the thinking stream of a turn (block closed).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "thinking_done"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "integer",
          "default": 1
        },
        "session_id": {
          "type": "string",
          "default": ""
        },
        "summary_hint": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
