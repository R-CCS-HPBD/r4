{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/control/v1/session_state.schema.json",
  "title": "session_state",
  "description": "Point-in-time session read-model (mode, actors, active extensions).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "session_state"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "integer",
          "default": 1
        },
        "session_id": {
          "type": "string",
          "default": ""
        },
        "project_id": {
          "type": "string",
          "default": ""
        },
        "mode": {
          "type": "string",
          "enum": [
            "ask_always",
            "auto_safe",
            "deny",
            "trust"
          ],
          "default": "ask_always"
        },
        "graphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actor": {
          "type": "string",
          "default": "human"
        }
      }
    }
  }
}
