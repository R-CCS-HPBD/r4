{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/set_mcp_server_enabled.schema.json",
  "title": "set_mcp_server_enabled",
  "description": "set_mcp_server_enabled: the re-read inventory plus the outcome;",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/SetMcpServerEnabledResult",
  "$defs": {
    "McpServerRow": {
      "type": "object",
      "description": "One MCP inventory row (registry entry or declared user-config row;",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "agent_visible": {
          "type": "boolean"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "status",
        "source",
        "agent_visible"
      ],
      "additionalProperties": true
    },
    "SetMcpServerEnabledResult": {
      "type": "object",
      "description": "set_mcp_server_enabled: the re-read inventory plus the outcome;",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpServerRow"
          }
        },
        "applied": {
          "type": "boolean"
        },
        "exposure": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "servers",
        "applied"
      ],
      "additionalProperties": true
    }
  }
}
