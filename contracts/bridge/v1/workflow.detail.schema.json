{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/workflow.detail.schema.json",
  "title": "workflow.detail",
  "description": "workflow.detail: the raw UMRS execution record, wrapped.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/WorkflowDetailResult",
  "$defs": {
    "WorkflowDetailResult": {
      "type": "object",
      "description": "workflow.detail: the raw UMRS execution record, wrapped.",
      "properties": {
        "execution": {
          "$ref": "#/$defs/WorkflowExecutionRecord"
        }
      },
      "required": [
        "execution"
      ],
      "additionalProperties": true
    },
    "WorkflowExecutionRecord": {
      "type": "object",
      "description": "The raw UMRS execution record (``ExecutionRecord.to_dict`` or its",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "workflow_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "submitted_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowStepProgress"
          }
        },
        "artifacts": {
          "type": "array"
        },
        "durable_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "durable_job": {
          "type": "object"
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "gates": {
          "type": "object"
        },
        "results": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "WorkflowStepProgress": {
      "type": "object",
      "description": "One step row of an execution record (UMRS ``StepProgress.to_dict``).",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "type": "number"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": true
    }
  }
}
