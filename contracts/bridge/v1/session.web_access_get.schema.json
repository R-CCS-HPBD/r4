{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/session.web_access_get.schema.json",
  "title": "session.web_access_get",
  "description": "session.web_access_get: the choice, the remembered last one, a launch preset.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/SessionWebAccessGetResult",
  "$defs": {
    "SessionWebAccessGetResult": {
      "type": "object",
      "description": "session.web_access_get: the choice, the remembered last one, a launch preset.",
      "properties": {
        "web_access": {
          "$ref": "#/$defs/WebAccessChoice"
        },
        "remembered": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebAccessChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "preset": {
          "type": "boolean"
        }
      },
      "required": [
        "web_access",
        "remembered",
        "preset"
      ],
      "additionalProperties": true
    },
    "WebAccessChoice": {
      "type": "object",
      "description": "The session's web-access choice (ADR-099 D-2; ``WebAccess.to_metadata``).",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "",
            "none",
            "allowlist",
            "public"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chosen_at": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "domains",
        "chosen_at",
        "source"
      ],
      "additionalProperties": true
    }
  }
}
