{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/list_active_agents.schema.json",
  "title": "list_active_agents",
  "description": "list_active_agents: flat active rows and their count.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/ListActiveAgentsResult",
  "$defs": {
    "AgentRecordRow": {
      "type": "object",
      "description": "One live agent (``AgentRecord.to_dict``; children are ids here).",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "current_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_count": {
          "type": "integer"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elapsed_sec": {
          "type": "number"
        }
      },
      "required": [
        "agent_id",
        "parent_id",
        "name",
        "task",
        "status",
        "current_tool",
        "last_tool",
        "started_at",
        "ended_at",
        "tool_count",
        "children",
        "elapsed_sec"
      ],
      "additionalProperties": true
    },
    "ListActiveAgentsResult": {
      "type": "object",
      "description": "list_active_agents: flat active rows and their count.",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentRecordRow"
          }
        },
        "active_count": {
          "type": "integer"
        }
      },
      "required": [
        "agents",
        "active_count"
      ],
      "additionalProperties": true
    }
  }
}
