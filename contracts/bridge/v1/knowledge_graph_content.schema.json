{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/knowledge_graph_content.schema.json",
  "title": "knowledge_graph_content",
  "description": "knowledge_graph_content: bounded nodes+edges with lampshade truncation.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/KnowledgeGraphContentResult",
  "$defs": {
    "GraphContentEdge": {
      "type": "object",
      "description": "One edge row of the bounded content view (``from`` is on the wire).",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "graph_id": {
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "label",
        "type",
        "graph_id",
        "created_at"
      ],
      "additionalProperties": true
    },
    "GraphContentNode": {
      "type": "object",
      "description": "One node row of the bounded content view.",
      "properties": {
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "graph_id": {
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "node_id",
        "name",
        "label",
        "type",
        "project_id",
        "graph_id",
        "created_at"
      ],
      "additionalProperties": true
    },
    "KnowledgeGraphContentResult": {
      "type": "object",
      "description": "knowledge_graph_content: bounded nodes+edges with lampshade truncation.",
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphContentNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphContentEdge"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "graph_id",
        "name",
        "kind",
        "project_id",
        "owner_id",
        "nodes",
        "edges",
        "truncated"
      ],
      "additionalProperties": true
    }
  }
}
