{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/research_knowledge.status.schema.json",
  "title": "research_knowledge.status",
  "description": "research_knowledge.status: location + graph digest.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/ResearchKnowledgeStatusResult",
  "$defs": {
    "ResearchKnowledgeStatusResult": {
      "type": "object",
