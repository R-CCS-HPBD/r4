{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/provenance.job.schema.json",
  "title": "provenance.job",
  "description": "provenance.job: UMRS ``ProvenanceResponse`` for one durable job.",
  "x-bridge-protocol": 1,
