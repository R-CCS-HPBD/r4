{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/assets.snapshot.schema.json",
  "title": "assets.snapshot",
  "description": "assets.snapshot: the caller's asset rows (relayed) and the snapshot hash.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/AssetsSnapshotResult",
  "$defs": {
    "AssetsSnapshotResult": {
      "type": "object",
      "description": "assets.snapshot: the caller's asset rows (relayed) and the snapshot hash.",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "snapshot_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rows",
        "snapshot_hash"
      ],
      "additionalProperties": true
    }
  }
}
