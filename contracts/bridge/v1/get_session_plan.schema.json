{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/get_session_plan.schema.json",
  "title": "get_session_plan",
  "description": "get_session_plan: the session's plan steps with dependency edges.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/GetSessionPlanResult",
  "$defs": {
    "GetSessionPlanResult": {
      "type": "object",
      "description": "get_session_plan: the session's plan steps with dependency edges.",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskRow"
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": true
    },
    "TaskRow": {
      "type": "object",
      "description": "One task-graph row (``Task.to_dict``).",
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "progress": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "child_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "parent_id",
        "title",
        "status",
        "progress",
        "created_at",
        "updated_at",
        "completed_at",
        "notes",
        "depends_on",
        "child_ids"
      ],
      "additionalProperties": true
    }
  }
}
