{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/research_loop.status.schema.json",
  "title": "research_loop.status",
  "description": "Result union for research_loop.status (see branches).",
  "x-bridge-protocol": 1,
  "anyOf": [
    {
      "$ref": "#/$defs/ResearchLoopStatusFound"
    },
    {
      "$ref": "#/$defs/ResearchLoopStatusNotFound"
    }
  ],
  "$defs": {
    "ResearchLoopStatusFound": {
      "type": "object",
      "description": "research_loop.status, visible loop: serialized state + recent iterations.",
