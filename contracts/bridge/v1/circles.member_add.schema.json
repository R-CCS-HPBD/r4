{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/circles.member_add.schema.json",
  "title": "circles.member_add",
  "description": "circles.member_add: the circle plus its roster after the add.",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/CirclesMemberAddResult",
  "$defs": {
    "CircleMemberRow": {
      "type": "object",
      "description": "One circle member (the store's member row).",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "added_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "added_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "user_id",
        "role",
        "added_by",
        "added_at"
      ],
      "additionalProperties": true
    },
    "CircleRow": {
      "type": "object",
      "description": "One circle listing row (``api/circles.py`` ``_row_response``).",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "circle_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "retired_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id",
        "circle_id",
        "name",
        "owner_id",
        "status",
        "retired_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "CirclesMemberAddResult": {
      "type": "object",
      "description": "circles.member_add: the circle plus its roster after the add.",
      "properties": {
        "circle": {
          "$ref": "#/$defs/CircleRow"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CircleMemberRow"
          }
        }
      },
      "required": [
        "circle",
        "members"
      ],
      "additionalProperties": true
    }
  }
}
