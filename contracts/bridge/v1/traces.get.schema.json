{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/traces.get.schema.json",
  "title": "traces.get",
  "description": "One execution trace (``TraceRecord.to_dict``).",
