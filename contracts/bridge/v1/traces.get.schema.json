          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object"
          }
