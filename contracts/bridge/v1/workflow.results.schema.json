{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r4.dev/contracts/bridge/v1/workflow.results.schema.json",
  "title": "workflow.results",
  "description": "workflow.run / workflow.results (``_serialize_workflow_result``).",
  "x-bridge-protocol": 1,
  "$ref": "#/$defs/WorkflowRunResult",
  "$defs": {
    "WorkflowRunResult": {
      "type": "object",
      "description": "workflow.run / workflow.results (``_serialize_workflow_result``).",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "workflow_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "artifacts": {
          "anyOf": [
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "workflow_name",
        "status",
        "artifacts",
        "outputs",
        "error"
      ],
      "additionalProperties": true
    }
  }
}
