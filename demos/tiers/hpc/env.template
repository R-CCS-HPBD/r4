# =============================================================================
# UMRS + RiVault HPC Demo - Environment Template
# =============================================================================
# Copy this file to env.hpc and configure for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Path to pre-staged model on shared filesystem (HuggingFace cache directory)
VLLM_PATH_TO_HUGGINGFACE=/shared/models/vllm/huggingface

# Model name (HuggingFace model ID)
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Parallelism settings (adjust based on GPU count)
VLLM_TP=1  # tensor parallelism
VLLM_PP=1  # pipeline parallelism

# -----------------------------------------------------------------------------
# Slurm Configuration (REQUIRED)
# -----------------------------------------------------------------------------
SLURM_PARTITION=gpu
SLURM_GPUS=1
SLURM_TIME=02:00:00
SLURM_CPUS=8
SLURM_MEM=64G

# Timeout for job to start (seconds)
JOB_START_TIMEOUT=300

# -----------------------------------------------------------------------------
# Login Node Services
# -----------------------------------------------------------------------------
# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=umrs

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# UMRS Server
UMRS_API_PORT=8000
UMRS_ZMQ_PORT=5555
S3_BUCKET=umrs-data

# Shared model path for UMRS embedding cache
SHARED_MODEL_PATH=/shared/models

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# Private network prefix (first 3 octets)
UMRS_PRIV_IP1TO3=10.0.5

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
GENAI_TZ=Asia/Tokyo

# -----------------------------------------------------------------------------
# Container Images (Optional - use defaults or build locally)
# -----------------------------------------------------------------------------
# UMRS_IMAGE=ghcr.io/riken-rccs/umrs:latest
