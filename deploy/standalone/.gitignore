# The root .gitignore has `**/env/` (a Python-virtualenv rule, line 42), which
# would silently drop this profile's env overlays from every commit. A nested
# .gitignore takes precedence, so re-include the directory here — and keep the
# generated secrets file out explicitly, below.
!env/

# Generated by `standalone.sh bootstrap`. Never commit.
env/.env.secrets
.env
seaweedfs/
s3cfg
mcp/

# Per-host overrides (STANDALONE_MODEL_HOST, model choices). Never committed.
env/local.env

# What `up` last ran with (profile, engine) and which env/local.env values
# quickstart chose itself (auto_*). Written by standalone.sh. Never committed.
env/.state
