# Copy to .env.secrets — or better, let `standalone.sh bootstrap` generate it,
# which writes 0600 with 32-byte random values and never prints them.
#
# .env.secrets is gitignored. Nothing under deploy/ may contain a real
# credential; the maintainers' gate scans this tree for known leaked literals.
# Leave every value below empty and let
# `standalone.sh bootstrap` fill them in.

POSTGRES_USER=umrs
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
JWT_SECRET=
# Required whenever UMRS_AUTH_MODE=strict. Without it, verify_claims fails for
# every module on jobs.get_caller_identity while the modules using
# request_identity(verify_hmac=False) still pass — a half-dead surface.
UMRS_HANDSHAKE_HMAC_SECRET=
LITELLM_MASTER_KEY=
S3_ROOT_USER=
S3_ROOT_PASSWORD=
S3_STS_SIGNING_KEY=
