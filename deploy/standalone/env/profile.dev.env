# Stand-alone — DEV profile (opt-in; ADR-090 D-2).
#
# Chosen by STANDALONE_PROFILE=dev, `standalone.sh up --dev`, or the
# quickstart for a new stack (decision D-6); `up` records it in env/.state
# and later verbs follow the record (2026-10-15). Every verb that applies it
# prints a banner (the quickstart says it in one line instead).
#
# What this profile relaxes is the CREDENTIAL and the DURABILITY, never the
# gate: UMRS_AUTH_MODE stays `strict`, because an auth bypass in a dev profile
# is how an auth bypass reaches production.

STANDALONE_PROFILE=dev

UMRS_AUTH_MODE=strict
GATEWAY_ENVIRONMENT=development

# Loopback-only bind; no CURVE handshake, for fast local iteration.
UMRS_ZMQ_AUTH_TYPE=none

# In-process steps: no sibling containers, much faster edit-run loops.
# Reaches the container through compose.dev.yaml (an env file alone only
# interpolates).
UMRS_STEP_EXECUTOR=inproc
# Uploaded workflow steps run in the UMRS process (ADR-074 transition switch),
# so `r4 project loop start --workflow <yours>` can run experiments here.
# Never in hardened: that profile refuses uploaded code until ADR-091.
UMRS_STEP_UPLOADED_CODE=legacy_in_process

# Same services as hardened. The former e2e mock leg (slurm-mock, compute-mock)
# is the `ci` profile — opt in with STANDALONE_PROFILES=core,ci for CI work.
STANDALONE_PROFILES=core,models-local
