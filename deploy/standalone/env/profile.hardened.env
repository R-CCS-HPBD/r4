# Stand-alone — HARDENED profile (the default; ADR-090 D-2).
#
# This file exists to set secure values EXPLICITLY rather than inherit them.
# It must never contain a relaxation knob, and every value it sets must reach a
# container or standalone.sh: tests/test_standalone_deployment_truth.py (SL-CONF
# T0) fails otherwise. The registered validator (plan WS-05) is not written yet.

STANDALONE_PROFILE=hardened

# Identity: the same strict path as the remote deployment.
UMRS_AUTH_MODE=strict
GATEWAY_ENVIRONMENT=production

# ZeroMQ: CURVE with ZAP identity binding. With `none`, _identity_provider()
# returns None and every ZMQ command acts as whatever client_id it claims —
# the SEC-20251004-001 class. Never set UMRS_ZMQ_SESSION_IDENTITY=off or
# UMRS_ZMQ_CURVE_ALLOW_ANY_CLIENT_KEY=true.
UMRS_ZMQ_AUTH_TYPE=session

# Workflow steps run as sibling containers (the PodmanExecutor). The umrs
# container has no podman socket yet, so steps cannot launch in this profile
# (README Known-missing, WS-08).
UMRS_STEP_EXECUTOR=podman

# Knowledge embedding runs in the UMRS process. The ADR-061 sandbox
# (UMRS_EMBEDDING_SANDBOX=podman) needs the same socket. Setting it before that
# leg lands fails every embed, by design: there is never a silent fallback.
# (Until 2026-10-09 this file set it, but no container ever received it.)

# Uploaded (user-authored) step code is refused by name while
# UMRS_STEP_UPLOADED_CODE is unset (ADR-074), until a podman lane joins
# HPC_LANES (ADR-091). This profile never sets it, and neither does site.yaml.
# Both are pinned by tests/test_standalone_deployment_truth.py.
# (Until 2026-10-09 this file set UMRS_STEP_TRUST_LANE=refuse, a name no code reads.)
